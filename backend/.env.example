# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# --- Required for the Claude-powered agents -------------------------------
# Without this the system still runs end to end using local analyzers.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is the current cost-efficient model (good for testing).
# Use claude-sonnet-5 or claude-opus-5 for higher-quality/higher-cost reviews.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Auth -----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- Database -------------------------------------------------------------
# Defaults to a local SQLite file. Point at Postgres for a hosted deployment:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/devintel
DATABASE_URL=

# --- Optional -------------------------------------------------------------
# Only needed to read public repo metadata at a higher rate limit.
GITHUB_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_FILES_PER_ANALYSIS=40
CLONE_TIMEOUT_SECONDS=90

# Pacing between pipeline stages so the Analysis Run screen is readable.
# Set to 0 to run at full speed.
STAGE_PACING_SECONDS=0.9

# --- Seeded demo account --------------------------------------------------
DEMO_EMAIL=demo@devintel.dev
DEMO_PASSWORD=demo1234
